# Content Hub (Next.js) — copy to .env.local
APP_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data

# xAI Grok
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# Postiz (self-hosted default: http://localhost:4007)
POSTIZ_BASE_URL=http://localhost:4007
POSTIZ_API_KEY=

# n8n webhook (optional — if set, repurpose can trigger the workflow)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/grow-10x-repurpose
N8N_WEBHOOK_SECRET=

# Prefer direct Grok/Postiz from the app, or "n8n" to only fire the webhook
REPURPOSE_MODE=direct
